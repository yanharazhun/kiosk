generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String            @id @default(uuid(7)) @db.Uuid
  name      Json
  imageUrl  String?
  products  ProductCategory[]
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?         @db.Timestamptz(3)
}

model Product {
  id             String                 @id @default(uuid(7)) @db.Uuid
  name           Json
  description    Json?
  imageUrl       String?
  priceMinor     Int
  isAvailable    Boolean                @default(true)
  mealProductId  String?                @db.Uuid
  mealProduct    Product?               @relation("MealUpgrade", fields: [mealProductId], references: [id], onDelete: SetNull)
  baseProducts   Product[]              @relation("MealUpgrade")
  categories     ProductCategory[]
  modifierGroups ProductModifierGroup[]
  usedAsModifier Modifier[]
  orderItems     OrderItem[]
  orderModifiers OrderItemModifier[]
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?              @db.Timestamptz(3)

  @@index([mealProductId])
}

model ProductCategory {
  categoryId String   @db.Uuid
  productId  String   @db.Uuid
  sortOrder  Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId])
  @@index([productId])
}

enum ModifierGroupKind {
  ADD
  REMOVE
}

model ModifierGroup {
  id        String                 @id @default(uuid(7)) @db.Uuid
  name      Json
  kind      ModifierGroupKind      @default(ADD)
  minSelect Int                    @default(0)
  maxSelect Int                    @default(1)
  modifiers Modifier[]
  products  ProductModifierGroup[]
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?              @db.Timestamptz(3)
}

model Modifier {
  groupId         String        @db.Uuid
  productId       String        @db.Uuid
  priceDeltaMinor Int           @default(0)
  maxQuantity     Int           @default(1)
  isDefault       Boolean       @default(false)
  sortOrder       Int           @default(0)
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([groupId, productId])
  @@index([productId])
}

model ProductModifierGroup {
  productId String        @db.Uuid
  groupId   String        @db.Uuid
  sortOrder Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum ServiceType {
  EAT_IN
  TAKE_AWAY
}

enum PaymentMethod {
  CARD
  COUNTER
}

model OrderCounter {
  businessDate DateTime @id @db.Date
  lastNumber   Int
}

model Order {
  id            String        @id @default(uuid(7)) @db.Uuid
  number        Int
  businessDate  DateTime      @db.Date
  status        OrderStatus   @default(PENDING_PAYMENT)
  serviceType   ServiceType
  paymentMethod PaymentMethod
  locale        String
  totalMinor    Int
  createdById   String        @db.Uuid
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items         OrderItem[]
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  paidAt        DateTime?     @db.Timestamptz(3)
  preparingAt   DateTime?     @db.Timestamptz(3)
  readyAt       DateTime?     @db.Timestamptz(3)
  completedAt   DateTime?     @db.Timestamptz(3)
  cancelledAt   DateTime?     @db.Timestamptz(3)

  @@unique([businessDate, number])
  @@index([status])
  @@index([createdById])
}

model OrderItem {
  id             String              @id @default(uuid(7)) @db.Uuid
  orderId        String              @db.Uuid
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String              @db.Uuid
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    Json
  basePriceMinor Int
  unitPriceMinor Int
  quantity       Int
  modifiers      OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id              String            @id @default(uuid(7)) @db.Uuid
  orderItemId     String            @db.Uuid
  orderItem       OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId       String            @db.Uuid
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  groupName       Json
  kind            ModifierGroupKind
  name            Json
  priceDeltaMinor Int
  quantity        Int

  @@index([orderItemId])
  @@index([productId])
}

enum Role {
  ADMIN
  KITCHEN
  KIOSK
}

model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  username       String    @unique
  displayName    String
  secretHash     String
  role           Role
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)
  sessions       Session[]
  orders         Order[]
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
}

model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}
